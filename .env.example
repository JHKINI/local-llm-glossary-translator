# 필요할 때만 복사해서 .env 로 쓰세요:  cp .env.example .env   (없어도 기본값으로 실행됩니다)

# Ollama 서버 주소. 기본값은 내 PC(호스트)의 Ollama 입니다.
# 다른 서버를 쓰려면 주소를 바꾸세요. (스킴을 생략해도 https 로 처리)
OLLAMA_URL=http://host.docker.internal:11434
# 사용할 모델명 (ollama list 에 보이는 이름)
OLLAMA_MODEL=qwen3.5:4b
# 번역 일관성을 위해 0 권장
TEMPERATURE=0

# 접속 포트 (브라우저에서 http://localhost:WEB_PORT)
WEB_PORT=8081
